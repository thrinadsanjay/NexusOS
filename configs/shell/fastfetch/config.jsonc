// NexusOS fastfetch configuration.
// Installed as /etc/xdg/fastfetch/config.jsonc by nexusos-branding (system-wide default).
// Users override it with ~/.config/fastfetch/config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/nexusos/ascii-logo.txt",
    "color": { "1": "38;2;49;198;189" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;49;198;189", "title": "38;2;196;119;80" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;196;119;80mBUILD. AUTOMATE. DEPLOY.\u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;158;179;183mCrafted by \u001b[38;2;196;119;80mSanjay\u001b[0m" },
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "Desktop" },
    { "type": "wm", "key": "Compositor" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk (/)", "folders": "/" },
    "break",
    "colors"
  ]
}
