# NexusOS operating system identification -- see os-release(5).
# Installed as /usr/lib/os-release by nexusos-branding (Ubuntu's original is
# preserved as /usr/lib/os-release.ubuntu via dpkg-divert and restored on removal).
#
# NexusOS is an independent distribution based on Ubuntu. It is not an official
# Ubuntu product and is not endorsed by Canonical Ltd.
#
# VERSION_CODENAME and UBUNTU_CODENAME intentionally stay "resolute" so that
# third-party APT repositories keyed on the Ubuntu codename keep working.
NAME="NexusOS"
PRETTY_NAME="NexusOS Engineering Edition 1.0"
ID=nexusos
ID_LIKE=ubuntu
VERSION_ID="1.0"
VERSION="1.0 LTS"
VERSION_CODENAME=resolute
UBUNTU_CODENAME=resolute
VARIANT="Engineering Edition"
VARIANT_ID=engineering
BUILD_ID="0.1.0-dev"
DEFAULT_HOSTNAME=nexusos
HOME_URL="https://github.com/thrinadsanjay/NexusOS"
SUPPORT_URL="https://github.com/thrinadsanjay/NexusOS/discussions"
BUG_REPORT_URL="https://github.com/thrinadsanjay/NexusOS/issues"
LOGO=nexusos
ANSI_COLOR="38;2;49;198;189"
