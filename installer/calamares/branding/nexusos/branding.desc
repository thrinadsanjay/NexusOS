# NexusOS Engineering Edition — Calamares branding.
# Images are rendered from the SVG masters when the package is built.
---
componentName: nexusos
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 1100px,720px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         "NexusOS Engineering Edition"
    shortProductName:    NexusOS
    version:             "1.0 (development)"
    shortVersion:        "1.0"
    versionedName:       "NexusOS Engineering Edition 1.0"
    shortVersionedName:  "NexusOS 1.0"
    bootloaderEntryName: Ubuntu        # keep the EFI directory /EFI/ubuntu: Ubuntu's signed GRUB looks there
    productUrl:          https://github.com/thrinadsanjay/NexusOS
    supportUrl:          https://github.com/thrinadsanjay/NexusOS/issues
    knownIssuesUrl:      https://github.com/thrinadsanjay/NexusOS/blob/main/docs/installation.md
    releaseNotesUrl:     https://github.com/thrinadsanjay/NexusOS/blob/main/CHANGELOG.md

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            1

style:
   SidebarBackground:        "#0B171B"
   SidebarText:              "#E8F1F2"
   SidebarTextCurrent:       "#31C6BD"
   SidebarBackgroundCurrent: "#123B40"
