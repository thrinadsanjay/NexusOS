+Device*
+PartitionPage::nexusCurrentDevice() const
+{
+    const QModelIndex index = m_core->deviceModel()->index( m_ui->deviceComboBox->currentIndex(), 0 );
+    return index.isValid() ? m_core->deviceModel()->deviceForIndex( index ) : nullptr;
+}
+
+void
+PartitionPage::nexusStandardLayout()
+{
+    Device* device = nexusCurrentDevice();
+    if ( !device || device->type() != Device::Type::Disk_Device )
+    {
+        QMessageBox::information( this, tr( "Default layout" ), tr( "Select a disk first (not a volume group)." ) );
+        return;
+    }
+    const auto answer = QMessageBox::question(
+        this,
+        tr( "Default layout" ),
+        tr( "Plan the NexusOS layout on %1: %2/boot, swap and / with the remaining space?<br/><br/>"
+            "This replaces the changes planned for this disk. Nothing is written until you start the "
+            "installation, and you can still edit, resize, delete or add partitions." )
+            .arg( device->deviceNode(), m_isEfi ? tr( "an EFI system partition, " ) : QString() ),
+        QMessageBox::Yes | QMessageBox::Cancel );
+    if ( answer != QMessageBox::Yes )
+    {
+        return;
+    }
+    auto* gs = Calamares::JobQueue::instance()->globalStorage();
+    const PartitionActions::Choices::AutoPartitionOptions options {
+        gs->value( "defaultPartitionTableType" ).toString(),
+        FileSystem::nameForType( m_config->defaultFsType() ),
+        m_config->luksFileSystemType(),
+        QString(),
+        gs->value( "efiSystemPartition" ).toString(),
+        Calamares::GiBtoBytes( gs->value( "requiredStorageGiB" ).toDouble() ),
+        Config::SwapChoice::SmallSwap
+    };
+    const int row = m_ui->deviceComboBox->currentIndex();
+    ScanningDialog::run(
+        QtConcurrent::run(
+            [ this, device ]
+            {
+                QMutexLocker locker( &m_revertMutex );
+                m_core->revertDevice( device );  // start from the disk as it is
+            } ),
+        [ this, row, options ]
+        {
+            m_ui->deviceComboBox->setCurrentIndex( row );
+            if ( Device* fresh = nexusCurrentDevice() )
+            {
+                PartitionActions::doAutopartition( m_core, fresh, options );
+            }
+            updateFromCurrentDevice();
+        },
+        this );
+}
+
+void
+PartitionPage::nexusLvmLayout()
+{
+    Device* device = nexusCurrentDevice();
+    if ( !device || device->type() != Device::Type::Disk_Device )
+    {
+        QMessageBox::information( this, tr( "LVM layout" ), tr( "Select a disk first (not a volume group)." ) );
+        return;
+    }
+    const QString node = device->deviceNode();
+
+    QDialog dialog( this );
+    dialog.setWindowTitle( tr( "LVM layout" ) );
+    auto* outer = new QVBoxLayout( &dialog );
+    auto* intro = new QLabel(
+        tr( "Creates on <b>%1</b>: %2/boot (2 GiB) and the LVM volume group <b>nexus</b> with swap and the "
+            "root volume. The rest of the volume group stays free for more logical volumes (/home, /var, "
+            "/var/lib/docker, …), which you can add on the next screen." )
+            .arg( node, m_isEfi ? tr( "an EFI system partition (1 GiB), " ) : QString() ),
+        &dialog );
+    intro->setWordWrap( true );
+    outer->addWidget( intro );
+    auto* form = new QFormLayout;
+    auto* fs = new QComboBox( &dialog );
+    fs->addItems( { QStringLiteral( "ext4" ), QStringLiteral( "xfs" ) } );
+    fs->setCurrentText( FileSystem::nameForType( m_config->defaultFsType() ) );
+    form->addRow( tr( "Root file system:" ), fs );
+    auto* root = new QSpinBox( &dialog );
+    root->setRange( 0, 65536 );
+    root->setSuffix( tr( " GiB" ) );
+    root->setSpecialValueText( tr( "Automatic (half the volume group, at least 30 GiB)" ) );
+    form->addRow( tr( "Root size:" ), root );
+    auto* swap = new QSpinBox( &dialog );
+    swap->setRange( -1, 512 );
+    swap->setValue( -1 );
+    swap->setSuffix( tr( " GiB" ) );
+    swap->setSpecialValueText( tr( "Like the memory size (at most 8 GiB)" ) );
+    swap->setToolTip( tr( "0 creates no swap volume." ) );
+    form->addRow( tr( "Swap size:" ), swap );
+    outer->addLayout( form );
+    const QString capacity = QString::number( double( device->capacity() ) / ( 1024.0 * 1024 * 1024 ), 'f', 1 );
+    auto* confirm = new QCheckBox(
+        tr( "Erase %1 now (%2 GiB). This happens immediately and cannot be undone." ).arg( node, capacity ), &dialog );
+    outer->addWidget( confirm );
+    auto* buttons = new QDialogButtonBox( QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &dialog );
+    buttons->button( QDialogButtonBox::Ok )->setText( tr( "Create layout" ) );
+    buttons->button( QDialogButtonBox::Ok )->setEnabled( false );
+    connect( confirm, &QCheckBox::toggled, buttons->button( QDialogButtonBox::Ok ), &QWidget::setEnabled );
+    connect( buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept );
+    connect( buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject );
+    outer->addWidget( buttons );
+    if ( dialog.exec() != QDialog::Accepted || !confirm->isChecked() )
+    {
+        return;
+    }
+
+    const QStringList args { QStringLiteral( "--disk" ),
+                             node,
+                             QStringLiteral( "--fs" ),
+                             fs->currentText(),
+                             QStringLiteral( "--root-gib" ),
+                             QString::number( root->value() ),
+                             QStringLiteral( "--swap-gib" ),
+                             QString::number( swap->value() ),
+                             QStringLiteral( "--confirm-disk" ),
+                             node,
+                             QStringLiteral( "--yes" ) };
+    auto result = std::make_shared< QPair< int, QString > >( -1, QString() );
+    ScanningDialog::run(
+        QtConcurrent::run(
+            [ this, args, result ]
+            {
+                QProcess process;
+                process.start( QStringLiteral( "/usr/libexec/nexusos/nexusos-lvm-layout" ), args );
+                process.waitForFinished( 10 * 60 * 1000 );
+                result->first = process.exitStatus() == QProcess::NormalExit ? process.exitCode() : -1;
+                result->second = QString::fromUtf8( process.readAllStandardError() ).trimmed();
+                cDebug() << "nexusos-lvm-layout" << args << "exit" << result->first << result->second;
+                QMutexLocker locker( &m_revertMutex );
+                m_core->revertAllDevices();  // rescan: the new partitions and volume group appear
+            } ),
+        [ this, result ]
+        {
+            if ( result->first != 0 )
+            {
+                QMessageBox::critical( this,
+                                       tr( "LVM layout" ),
+                                       tr( "The layout could not be created:\n%1" )
+                                           .arg( result->second.isEmpty() ? tr( "unknown error" ) : result->second ) );
+            }
+            else
+            {
+                nexusAssignMountPoints();
+            }
+            updateFromCurrentDevice();
+        },
+        this );
+}
+
+void
+PartitionPage::nexusAssignMountPoints()
+{
+    auto* gs = Calamares::JobQueue::instance()->globalStorage();
+    QString efi = gs->value( "efiSystemPartition" ).toString();
+    if ( efi.isEmpty() )
+    {
+        efi = QStringLiteral( "/boot/efi" );
+    }
+    const QMap< QString, QString > byLabel { { QStringLiteral( "NEXUS-EFI" ), efi },
+                                             { QStringLiteral( "nexus-boot" ), QStringLiteral( "/boot" ) },
+                                             { QStringLiteral( "nexus-root" ), QStringLiteral( "/" ) },
+                                             { QStringLiteral( "nexus-swap" ), QString() } };
+    DeviceModel* devices = m_core->deviceModel();
+    for ( int row = 0; row < devices->rowCount(); ++row )
+    {
+        Device* device = devices->deviceForIndex( devices->index( row, 0 ) );
+        if ( !device || !device->partitionTable() )
+        {
+            continue;
+        }
+        for ( auto it = Calamares::Partition::PartitionIterator::begin( device );
+              it != Calamares::Partition::PartitionIterator::end( device );
+              ++it )
+        {
+            Partition* partition = *it;
+            const QString label = partition->fileSystem().label();
+            if ( !byLabel.contains( label ) )
+            {
+                continue;
+            }
+            m_core->clearJobs( device, partition );
+            PartitionInfo::reset( partition );
+            if ( !byLabel.value( label ).isEmpty() )
+            {
+                PartitionInfo::setMountPoint( partition, byLabel.value( label ) );
+            }
+            m_core->formatPartition( device, partition );  // fresh filesystem, and claims swap for fstab
+            PartitionInfo::setFormat( partition, true );
+            cDebug() << "NexusOS layout:" << partition->partitionPath() << label << "->" << byLabel.value( label );
+        }
+    }
+}
